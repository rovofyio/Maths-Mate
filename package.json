{
  "name": "maths-mate",
  "private": true,
  "version": "2.0.0",
  "description": "Math Aura \u2014 a kid-friendly maths game app with 10 games, coins, daily spinner, achievements and a leaderboard.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "cap:sync": "cap sync",
    "cap:add:android": "cap add android",
    "cap:add:ios": "cap add ios",
    "build:android": "npm run build && cap sync android",
    "build:ios": "npm run build && cap sync ios"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.1.0",
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.5.0",
    "@preact/signals": "^1.3.0",
    "preact": "^10.24.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@preact/preset-vite": "^2.10.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^22.7.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.3"
  }
}
